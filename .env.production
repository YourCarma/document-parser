SERVICE_NAME=document-parser
HOST=0.0.0.0
PORT=1338
PARSER_WORKERS=3
PRODUCTION_MODE=false
POST_REQUEST_TIMEOUT=100

VLM_BASE_URL=http://localhost:8091
VLM_MODEL_NAME=/models/vlm/Qwen3VL-8B-Instruct-Q8_0.gguf
VLM_API_KEY=no-key-required
VLM_TIMEOUT_SECS=30
VLM_MAX_TOKENS=10000

TRANSLATOR_ADDRESS=http://localhost:10015
TRANSLATE_URI=/api/v1/translate/text
TRANSALTOR_MAX_CONCURRENCY=15
DETECT_LANGUAGE_URL="http://localhost:10015/api/v1/detect_language"

WEBHOOK_MANAGER_URL="http://localhost:10001"
WATCHTOWER_URL="http://localhost:2893"
RESOURCE_MANAGER_URL="http://localhost:2899"
WATCHTOWER_SHARED_HOST="http://localhost:9000"

TASK_CANCEL_CHECK_TTL_SECS=5
PARSE_TIMEOUT_SECS=900
SOFFICE_TIMEOUT_SECS=180
TASK_TIMEOUT_SECS=3000
MAX_DOWNLOAD_FILE_SIZE_MB=200

BROKER_ENABLED=false
BROKER_TYPE=rabbitmq
RMQ_URL=amqp://user:replace-me@localhost:5672/
RMQ_EXCHANGE=document-parser.tasks
RMQ_EXCHANGE_TYPE=direct
RMQ_QUEUE=document-parser.queue
RMQ_ROUTING_KEYS=["document-parser.translate"]
RMQ_PREFETCH_COUNT=3
RMQ_DLX=document-parser.dlx
RMQ_DLQ=document-parser.dlq
RMQ_RETRY_QUEUE=document-parser.retry
RMQ_RETRY_DELAY_SECS=30
RMQ_MAX_RETRIES=3
RMQ_RECONNECT_INTERVAL_SECS=5
RMQ_CONSUMER_TAG=document-parser
RMQ_DECLARE_TOPOLOGY=true
RMQ_ACK_DEADLINE_SECS=3600
RMQ_SHUTDOWN_GRACE_SECS=60
RMQ_DLQ_CHECK_INTERVAL_SECS=60
TRANSLATE_OUTPUT_PREFIX=translated/{task_id}
